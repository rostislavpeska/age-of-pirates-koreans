<tactics>
  <!-- Korean House (zpHouseKorean). RangedAttack: the Chinese Village pattern (village.tactics) - fires only
       while units are inside, damage x number inside (cap 3 = the house's capacity: 5 to 15 per volley); off until
       zpKoreanHouseArrows (Colonial Age). SpawnChristmasTree and SpawnCowboy: AoP adds these to every house
       (techtreemods ActionAdd unittype AbstractHouse), so this file carries AoP's shrine.tactics copies. -->
  <action>
    <name stringid="38133">RangedAttack</name>
    <type>Attack</type>
    <attackaction>1</attackaction>
    <rangedlogic>1</rangedlogic>
    <activeifcontainsunits>1</activeifcontainsunits>
    <damagefactorcap>3</damagefactorcap>
    <scalebycontainedunits>1</scalebycontainedunits>
    <anim>RangedAttack</anim>
    <maxheight>0</maxheight>
    <accuracy>1.0</accuracy>
    <aimbonus>0</aimbonus>
    <maxspread>5</maxspread>
    <spreadfactor>0.25</spreadfactor>
    <trackrating>120</trackrating>
    <unintentionaldamagemultiplier>0.7</unintentionaldamagemultiplier>
    <projectile>InvisibleProjectile</projectile>
    <impacteffect>effects\impacts\gun</impacteffect>
    <rate type="Unit">1.0 </rate>
    <instantballistics>1</instantballistics>
    <perfectaccuracy>1</perfectaccuracy>
    <active>0</active>
  </action>
  <action>
    <name stringid="69158">SpawnChristmasTree</name>
    <type>Spawn</type>
    <rate type="TreeChristmas">1.0 </rate>
    <active>1</active>
    <persistent>0</persistent>
    <singleuse>1</singleuse>
  </action>
  <action>
    <name stringid="69158">SpawnCowboy</name>
    <type>Spawn</type>
    <rate type="zpMercMountedOutlaw">1.0</rate>
    <active>1</active>
    <persistent>0</persistent>
    <singleuse>1</singleuse>
  </action>
  <tactic>Normal<attacktype>LogicalTypeRangedUnitsAttack</attacktype><autoattacktype>LogicalTypeRangedUnitsAutoAttack</autoattacktype><attackresponsetype>LogicalTypeRangedUnitsAttack</attackresponsetype><action priority="75">RangedAttack</action></tactic>
</tactics>
