    <rollovertextid>600017</rollovertextid>
    <flag>UniqueTech</flag>
    <flag>CountsTowardMilitaryScore</flag>
    <flag>YPMonasteryTech</flag>
    <effects>
      <effect type="Data" action="VolleyRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="Data" action="DefendRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="Data" action="StaggerRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="Data" action="Stun" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="Data" action="VolleyRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean2</target>
      </effect>
      <effect type="Data" action="DefendRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean2</target>
      </effect>
      <effect type="Data" action="StaggerRangedAttack" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean2</target>
      </effect>
      <effect type="Data" action="Stun" amount="4.00" subtype="MaximumRange" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean2</target>
      </effect>
      <effect type="Data" action="VolleyRangedAttack" amount="1.25" subtype="Damage" relativity="BasePercent">
