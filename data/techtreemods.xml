  <!-- Dure (village work cooperative): villagers near a Korean monk gather faster (aura in zpmonkkorean.tactics), slot 2; WoL Jinbohoe idea -->
  <tech name="zpMonasteryDure" type="Normal">
    <dbid>60007</dbid>
    <displaynameid>600018</displaynameid>
    <cost resourcetype="Food">200.0000</cost>
    <cost resourcetype="Wood">200.0000</cost>
    <researchpoints>15.0000</researchpoints>
    <status>UNOBTAINABLE</status>
    <icon>resources\images\icons\techs\korean\zpmonasterydure.png</icon>
    <rollovertextid>600019</rollovertextid>
    <flag>UniqueTech</flag>
    <flag>CountsTowardEconomicScore</flag>
    <flag>YPMonasteryTech</flag>
    <effects>
      <effect type="Data" action="Dure" amount="1.00" subtype="ActionEnable" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="Data" action="Dure" amount="1.00" subtype="ActionEnable" relativity="Absolute">
        <target type="ProtoUnit">zpMonkKorean2</target>
      </effect>
    </effects>
  </tech>
