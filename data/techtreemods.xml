      </effect>
      <effect type="Data" amount="15.00" subtype="BuildLimit" relativity="Assign">
        <target type="ProtoUnit">zpSeungbyeong</target>
      </effect>
    </effects>
  </tech>
  <!-- Seungbyeong age-ups: the Disciple scales only through the Chinese age techs (hit points and damage x1.20
       Colonial, x1.30 Fortress, x1.40 Industrial, x1.50 Imperial, +0.5 speed at Colonial); Korea ages up with the
       Japanese techs, so these shadow techs give zpSeungbyeong the same lines when the generic age tech is active
       (armed by zpKoreanUnits, the zpKoreanHouseArrows pattern). The Disciple's killing-blow lines are left out:
       the Seungbyeong's attacks have no killing blow. -->
  <tech name="zpSeungbyeongColonial" type="Normal">
    <dbid>60010</dbid>
    <researchpoints>0.0000</researchpoints>
    <status>UNOBTAINABLE</status>
    <flag>Shadow</flag>
    <prereqs>
      <techstatus status="Active">Colonialize</techstatus>
      <techstatus status="Active">zpKoreanVisuals</techstatus>
    </prereqs>
    <effects>
      <effect type="Data" amount="1.20" subtype="Hitpoints" relativity="BasePercent">
        <target type="ProtoUnit">zpSeungbyeong</target>
      </effect>
      <effect type="Data" amount="1.20" subtype="Damage" allactions="1" relativity="BasePercent">
        <target type="ProtoUnit">zpSeungbyeong</target>
      </effect>
      <effect type="Data" amount="0.50" subtype="MaximumVelocity" relativity="Absolute">
        <target type="ProtoUnit">zpSeungbyeong</target>
      </effect>
    </effects>
  </tech>
  <tech name="zpSeungbyeongFortress" type="Normal">
