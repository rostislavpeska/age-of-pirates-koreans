  <!-- Seungbyeong (monk soldiers): the Seungjang trains the Seungbyeong (zpSeungbyeong) in the field and up
       to 15 of them instead of 10 (owner 2026-10-09; replaces the Chinese Disciple placeholder), slot 4 -->
  <tech name="zpMonasterySeungbyeong" type="Normal">
    <dbid>60009</dbid>
    <displaynameid>600020</displaynameid>
    <cost resourcetype="Wood">350.0000</cost>
    <cost resourcetype="Gold">350.0000</cost>
    <researchpoints>15.0000</researchpoints>
    <status>UNOBTAINABLE</status>
    <icon>resources\images\icons\techs\korean\zpmonasteryseungbyeong.png</icon>
    <rollovertextid>600021</rollovertextid>
    <flag>UniqueTech</flag>
    <flag>CountsTowardMilitaryScore</flag>
    <flag>YPMonasteryTech</flag>
    <effects>
      <effect type="CommandAdd" proto="zpSeungbyeong" page="6" column="7">
        <target type="ProtoUnit">zpMonkKorean</target>
      </effect>
      <effect type="CommandAdd" proto="zpSeungbyeong" page="6" column="7">
