<material>
  <!--Korean TC damaged model. mata/matb = the TC pages; matc = the shared Korean r65 atlas for the backing AND
      the cut faces (2026-10-08: the vanilla destruction sheet is no longer used). Shaders as vanilla damaged
      materials: destructible on the main page, cutout on the alpha page.-->
  <submaterial name="mata">
    <materialdef name="destructible" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_tc\textures\korean_tc_mata_BaseColor" />
      <texture name="Normals" override="buildings\korean_tc\textures\korean_tc_mata_Normals" />
      <texture name="Masks" override="buildings\korean_tc\textures\korean_tc_mata_Masks" />
      <texture name="Details" override="buildings\korean_tc\textures\korean_tc_mata_Details" />
    </parameters>
  </submaterial>
  <submaterial name="matb">
    <materialdef name="default_cutout" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_tc\textures\korean_tc_matb_BaseColor" />
      <texture name="Normals" override="buildings\korean_tc\textures\korean_tc_matb_Normals" />
      <texture name="Masks" override="buildings\korean_tc\textures\korean_tc_matb_Masks" />
    </parameters>
  </submaterial>
  <submaterial name="matc">
    <materialdef name="default" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_shared\textures\korean_shared_matc_r65_BaseColor" />
      <texture name="Normals" override="buildings\korean_shared\textures\korean_shared_matc_r65_Normals" />
      <texture name="Masks" override="buildings\korean_shared\textures\korean_shared_matc_r65_Masks" />
    </parameters>
  </submaterial>
</material>
